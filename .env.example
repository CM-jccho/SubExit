# Server only. Never use NEXT_PUBLIC_ for API keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
COACH_AI_ENABLED=false
COACH_VOICE_ENABLED=false
# Free mode is for non-sensitive fictional/sample conversations only.
# 'paid' changes disclosures, NOT actual Google billing. Verify your account first.
GEMINI_DATA_MODE=free
